# Application
APP_ENV=dev

# Database (use service hostname `postgres` inside Docker Compose)
DATABASE_URL=postgresql+asyncpg://offer:offer@postgres:5432/offer_helper

# Redis (use service hostname `redis` inside Docker Compose)
REDIS_URL=redis://redis:6379/0

# LLM provider secrets (never commit real values)
LLM_API_KEY=replace-me
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=gpt-4o-mini
