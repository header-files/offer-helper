# 环境(dev: 开发环境、test: 测试环境、 prod: 生产环境)
APP_ENV=dev

# 数据库
DATABASE_URL=postgresql+asyncpg://testuser:testpassword@localhost:5432/testdb
# 若使用Docker部署时需要注意，Docker Compose 里面会覆盖为:
# DATABASE_URL=postgresql+asyncpg://offer:offer@postgres:5432/offer_helper

# Redis
REDIS_URL=redis://localhost:6379/0
# 若使用Docker部署时需要注意，Docker Compose 里面会覆盖为:
# redis://redis:6379/0
# Sentinel: sentinel://:password@mymaster?sentinels=host1:26379,host2:26379
# Cluster: cluster://:password@host:6379?nodes=host2:6379,host3:6379

# 大模型 API 密钥 — config/llm.models 文件中每个模型名称对应一个 API 密钥
LLM_CHAT_API_KEY=replace-me
LLM_REASONER_API_KEY=replace-me
